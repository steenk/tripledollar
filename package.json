{
  "name": "tripledollar",
  "version": "2.0.0",
  "description": "Compact, zero-dependency DOM scripting",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/tripledollar.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/tripledollar.js"
    },
    "./global": "./dist/tripledollar.min.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "homepage": "https://tripledollar.net",
  "repository": {
    "type": "git",
    "url": "https://github.com/steenk/tripledollar.git"
  },
  "author": "Steen Klingberg",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "rollup -c && tsc --emitDeclarationOnly",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run typecheck && npm run build && npm test"
  },
  "keywords": [
    "dom",
    "dom-scripting",
    "hyperscript",
    "browser",
    "svg",
    "tdstruct"
  ],
  "devDependencies": {
    "@rollup/plugin-terser": "^1.0.2",
    "happy-dom": "^21.0.4",
    "rollup": "^4.68.8",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12"
  }
}
